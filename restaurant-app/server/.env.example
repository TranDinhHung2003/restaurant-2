# Copy file này thành ".env" rồi điền giá trị thật, KHÔNG commit file .env lên git

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/restaurant

# Server
PORT=4000

# Domain công khai của web (dùng để sinh qr_code_link cho từng bàn).
# Khi deploy thật, đổi thành domain của bạn, vd: https://tennhahang.com
# Để trống thì hệ thống tự lấy domain của request (đủ dùng khi chạy demo local).
PUBLIC_URL=

# Múi giờ để lọc món theo khung giờ phục vụ (available_hours)
TIMEZONE=Asia/Ho_Chi_Minh

# Đăng nhập admin (bản MVP dùng 1 tài khoản duy nhất)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doimatkhaunay123

# JWT — chuỗi bí mật để ký token đăng nhập admin, đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=doi_chuoi_nay_thanh_ngau_nhien_va_dai

# Tài khoản ngân hàng nhận thanh toán VietQR
# Tra mã BIN ngân hàng tại: https://api.vietqr.io/v2/banks
BANK_BIN=970436
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=QUAN NHA

# Secret bảo vệ webhook TỰ ĐỘNG xác nhận thanh toán (POST /api/payments/webhook).
# BẮT BUỘC nếu muốn VietQR tự xác nhận khi khách chuyển khoản thành công
# (không cần khách/admin bấm tay). Điền chuỗi ngẫu nhiên dài rồi cấu hình
# cùng chuỗi này bên Casso/SePay/PayOS.
# Để trống = webhook bị khoá; đơn VietQR sẽ ở trạng thái "Chờ ngân hàng".
WEBHOOK_SECRET=
